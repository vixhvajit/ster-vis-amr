      <sensor name="left_camera" type="camera">
        <pose>0.08260 0.03000 0.11850 0.00000 0.00000 0.00000</pose>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <topic>/amr/stereo/left/image</topic>
        <camera name="left">
