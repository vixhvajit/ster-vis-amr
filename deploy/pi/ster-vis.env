# Ster-Vis service settings for the test AMR. Copy over the one Ster-Vis
# installed, then restart it:
#   sudo cp deploy/pi/ster-vis.env /etc/ster-vis/ster-vis.env
#   sudo systemctl restart ster-vis
#
# --min-distance 300: match down to 0.3 m. The 60 mm baseline needs more
#   disparities for that than the default 0.5 m, and the robot must see what is
#   close to it.
# --scan-*: the 2D scan the /api/v1 clients read. amr builds its own scan from
#   the depth map with its own band (see src/amr/config.py), so these only
#   matter to other clients, but match them anyway: from 3 cm above the floor
#   (lens about 0.07 m up) to 5 cm above the lens, out to 2.5 m.
STER_VIS_ARGS="--preset pi5 --width 1280 --height 720 --focus 1.0 --stream 8080 --min-distance 300 --scan-min-height -0.04 --scan-max-height 0.05 --scan-range-max 2.5 --scan-beams 121"
